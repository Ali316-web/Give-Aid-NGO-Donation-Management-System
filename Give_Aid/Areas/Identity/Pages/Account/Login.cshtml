@page
@model LoginModel

@{
    ViewData["Title"] = "Log In";
    Layout = "_clientlayout";
}

<section class="section container" style="max-width:480px;">
    <div class="text-center" style="margin-bottom:24px;">
        <span class="eyebrow" style="justify-content:center;">Welcome back</span>
        <h1>Log In</h1>
        <p>Log in to donate, track your donations, and raise queries.</p>
    </div>

    <div class="card">
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="input" autocomplete="username" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="error-msg"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" class="input" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="error-msg"></span>
            </div>

            <div class="flex justify-between items-center" style="margin-bottom:16px;">
                <label class="checkbox-row">
                    <input asp-for="Input.RememberMe" />
                    <span>@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                </label>
                <a id="forgot-password" asp-page="./ForgotPassword" style="font-size:13px;font-weight:600;color:var(--banyan-700);">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Log In</button>
        </form>

        <div class="text-center" style="margin-top:18px;font-size:14px;">
            <p>Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" style="font-weight:700;color:var(--banyan-700);">Register here</a></p>
            <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation" style="font-size:13px;color:var(--ink-500);">Resend email confirmation</a></p>
        </div>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="section-divider">or continue with</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="flex gap-3" style="justify-content:center;flex-wrap:wrap;">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn btn-outline btn-sm" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                            @provider.DisplayName
                        </button>
                    }
                </div>
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
