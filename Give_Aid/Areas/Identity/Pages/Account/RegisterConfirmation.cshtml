@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
}

<style>
    .ga-auth-shell {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .ga-auth-card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border: 1px solid #E7E2D9;
        border-radius: 16px;
        box-shadow: 0 12px 32px rgba(31, 93, 80, 0.08);
        padding: 36px 32px;
        text-align: center;
    }

    .ga-auth-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 24px;
    }

    .ga-auth-logo span {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 20px;
        color: #1F5D50;
        letter-spacing: 0.02em;
    }

    .ga-auth-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #EAF4F1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ga-auth-card h1 {
        font-family: 'Fraunces', serif;
        font-size: 24px;
        font-weight: 600;
        color: #1B1B1B;
        margin: 0 0 12px;
    }

    .ga-auth-card p {
        color: #6B6459;
        font-size: 14.5px;
        line-height: 1.6;
        margin: 0 0 20px;
    }

    .ga-auth-card p strong {
        color: #1B1B1B;
    }

    .ga-btn-primary {
        display: inline-block;
        width: 100%;
        background: #1F5D50;
        color: #ffffff;
        font-weight: 600;
        font-size: 15px;
        padding: 12px 20px;
        border-radius: 10px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        box-sizing: border-box;
    }

    .ga-btn-primary:hover {
        background: #17453B;
        color: #ffffff;
    }

    .ga-auth-back {
        display: inline-block;
        margin-top: 20px;
        font-size: 14px;
        color: #1F5D50;
        text-decoration: none;
        font-weight: 500;
    }

    .ga-auth-back:hover {
        text-decoration: underline;
    }
</style>

<div class="ga-auth-shell">
    <div class="ga-auth-card">
        <div class="ga-auth-logo">
            <svg width="32" height="32" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="20" r="20" fill="#1F5D50" />
                <path d="M20 8c-1 3-3 4-3 7 0 2 1 3 3 3s3-1 3-3c0-3-2-4-3-7Z" fill="#F0A93C" />
                <path d="M20 17v8M14 30c0-4 2-6 6-6s6 2 6 6M11 30h18M13 26c1-3 3-4 7-4M27 26c-1-3-3-4-7-4"
                      stroke="#F0A93C" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <span>GIVE-AID</span>
        </div>

        <div class="ga-auth-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7l9 6 9-6" stroke="#1F5D50" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                <rect x="3" y="5" width="18" height="14" rx="2" stroke="#1F5D50" stroke-width="1.8" />
                <path d="M8 15l2.5 2.5L17 11" stroke="#F0A93C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>

        @if (Model.DisplayConfirmAccountLink)
        {
            <h1>Confirm your account</h1>
            <p>
                No live email sender is configured yet, so here's your confirmation link for testing —
                in production this would be emailed to <strong>@Model.Email</strong> automatically.
            </p>
            <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="ga-btn-primary">Confirm my account</a>
        }
        else
        {
            <h1>Check your inbox</h1>
            <p>
                We've sent a confirmation link to <strong>@Model.Email</strong>.
                Click the link in that email to activate your account.
            </p>
        }

        <a asp-area="Identity" asp-page="/Account/Login" class="ga-auth-back">Back to sign in</a>
    </div>
</div>
