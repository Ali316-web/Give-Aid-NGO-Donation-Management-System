@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
    Layout = "_clientlayout";
}

<section class="section container" style="max-width:480px;">
    <div class="text-center" style="margin-bottom:24px;">
        <span class="eyebrow" style="justify-content:center;">Join us</span>
        <h1>Create an Account</h1>
        <p>Register to donate, raise queries, and register interest in programmes.</p>
    </div>

    <div class="card">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="All    " class="text-danger"></div>

            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="input" autocomplete="username" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="error-msg"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" class="input" autocomplete="new-password" placeholder="At least 6 characters" />
                <span asp-validation-for="Input.Password" class="error-msg"></span>
            </div>

            <div class="field">
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" class="input" autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="error-msg"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Register</button>
        </form>

        <div class="text-center" style="margin-top:18px;font-size:14px;">
            <p>Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" style="font-weight:700;color:var(--banyan-700);">Log in here</a></p>
        </div>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="section-divider">or continue with</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="flex gap-3" style="justify-content:center;flex-wrap:wrap;">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn btn-outline btn-sm" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                            @provider.DisplayName
                        </button>
                    }
                </div>
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
