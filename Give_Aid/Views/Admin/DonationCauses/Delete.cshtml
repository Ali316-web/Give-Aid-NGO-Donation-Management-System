@model Give_Aid.Models.DonationCause
@{
    ViewData["Title"] = "Delete Cause";
    Layout = "_adminlayout";
}

<div class="page-head">
    <div>
        <h1>Delete this cause?</h1>
        <p class="text-muted" style="margin:0;">Donations already linked to this cause will keep their historical record.</p>
    </div>
</div>

<div class="card" style="border-color:var(--danger,#dc2626);">
    <dl class="row">
        <dt class="col-sm-3">Cause</dt>
        <dd class="col-sm-9">@Model.Cause</dd>

        <dt class="col-sm-3">Raised</dt>
        <dd class="col-sm-9">Rs @Model.Raised.ToString("N0")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-outline">Cancel</a>
    </form>
</div>
