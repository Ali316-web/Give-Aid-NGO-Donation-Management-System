@model Give_Aid.Models.AdminContact

@{
    ViewData["Title"] = "Delete Message";
    Layout = "~/Views/Shared/_adminlayout.cshtml";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Delete this message?</h1>
        <p class="text-muted">This cannot be undone.</p>
    </div>

    <div class="card border-danger">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">From</dt>
                <dd class="col-sm-9">@Model.FullName (@Model.FromEmail)</dd>

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>

</div>
