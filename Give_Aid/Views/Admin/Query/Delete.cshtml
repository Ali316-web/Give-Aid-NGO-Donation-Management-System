@model Give_Aid.Models.Queries

@{
    ViewData["Title"] = "Delete Query";
    Layout = "_adminlayout";
}

<div class="page-head">
    <div>
        <h1>Delete Query</h1>
        <p class="text-muted" style="margin:0;">Are you sure you want to delete this query? This cannot be undone.</p>
    </div>
</div>

<div class="card" style="border-color:var(--danger,#dc2626);">
    <dl class="row">
        <dt class="col-sm-3">Query ID</dt>
        <dd class="col-sm-9">#Q-@Model.Id.ToString("D4")</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash"></i> Delete Query
        </button>
        <a asp-action="Index" class="btn btn-outline">Cancel</a>
    </form>
</div>
