@model IEnumerable<Give_Aid.Models.Queries>

@{
    ViewData["Title"] = "Queries";
    Layout = "_adminlayout";
}

<div class="breadcrumb" style="margin-bottom:14px;">
    <a asp-controller="Home" asp-action="Admin">Admin</a><span class="sep">/</span><span class="current">Queries</span>
</div>

<div class="page-head">
    <div>
        <h1>Query Management</h1>
        <p class="text-muted" style="margin:0;max-width:56ch;">All queries submitted by members through the public site.</p>
    </div>
</div>

<div class="gallery-filters" style="margin-bottom:16px;">
    <a asp-action="Index" asp-route-status="All" class="chip @(ViewBag.CurrentStatus == "All" ? "active" : "")">All Queries</a>
    <a asp-action="Index" asp-route-status="Pending" class="chip @(ViewBag.CurrentStatus == "Pending" ? "active" : "")">Pending</a>
    <a asp-action="Index" asp-route-status="In Progress" class="chip @(ViewBag.CurrentStatus == "In Progress" ? "active" : "")">In Progress</a>
    <a asp-action="Index" asp-route-status="Replied" class="chip @(ViewBag.CurrentStatus == "Replied" ? "active" : "")">Replied</a>
    <a asp-action="Index" asp-route-status="Closed" class="chip @(ViewBag.CurrentStatus == "Closed" ? "active" : "")">Closed</a>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Query ID</th>
                    <th>User</th>
                    <th>Subject</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#Q-@item.Id.ToString("D4")</td>
                        <td>@item.Name</td>
                        <td>@item.Subject</td>
                        <td>@item.Category</td>
                        <td>@item.SubmittedDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @{
                                var badgeClass = item.Status switch
                                {
                                    "Replied" => "badge-success",
                                    "In Progress" => "badge-warning",
                                    "Closed" => "badge-neutral",
                                    _ => "badge-danger"
                                };
                            }
                            <span class="badge @badgeClass">@item.Status</span>
                        </td>
                        <td class="row-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="icon-btn" title="View">
                                <i class="fa-regular fa-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn danger" title="Delete">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-muted text-center">No queries in this category.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
