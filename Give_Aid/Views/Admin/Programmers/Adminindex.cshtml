@model IEnumerable<Give_Aid.Models.Programmers>
@{
    ViewData["Title"] = "Programmes";
    Layout = "_adminlayout";
    var counts = ViewBag.ParticipantCounts as Dictionary<int, int> ?? new();
}

<div class="breadcrumb" style="margin-bottom:14px;">
    <a asp-controller="Home" asp-action="Admin">Admin</a><span class="sep">/</span><span class="current">Programmes</span>
</div>

<div class="page-head">
    <div>
        <h1>Programme Management</h1>
        <p class="text-muted" style="margin:0;max-width:56ch;">Create and manage programmes run by GIVE-AID's associated NGOs.</p>
    </div>
    <div class="flex gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Add Programme</a>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Programme</th><th>Category</th><th>Date</th><th>Location</th><th>Status</th><th>Participants</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var count = counts.TryGetValue(item.Id, out var c) ? c : 0;
                    var badgeClass = item.Status switch
                    {
                        "Upcoming" => "badge-info",
                        "Ongoing" => "badge-warning",
                        "Cancelled" => "badge-danger",
                        _ => "badge-neutral"
                    };
                    <tr>
                        <td>@item.Programme</td>
                        <td>@item.Category</td>
                        <td>@item.ProgrammeDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.Location</td>
                        <td><span class="badge @badgeClass">@item.Status</span></td>
                        <td>
                            <a asp-action="Participants" asp-route-id="@item.Id">@count interested</a>
                        </td>
                        <td class="row-actions">
                            <a asp-action="AdminDetails" asp-route-id="@item.Id" class="icon-btn" title="View"><i class="fa-regular fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-muted text-center">No programmes yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
