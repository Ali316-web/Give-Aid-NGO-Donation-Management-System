@model IEnumerable<Give_Aid.Models.Members>

@{
    ViewData["Title"] = "Members";
    Layout = "~/Views/Shared/_adminlayout.cshtml";
}

<div class="breadcrumb" style="margin-bottom:14px;">
    <a asp-controller="Home" asp-action="Index">Admin</a><span class="sep">/</span><span class="current">Members</span>
</div>

<div class="page-head">
    <div>
        <h1>Member Management</h1>
        <p class="text-muted" style="margin:0;max-width:56ch;">View and manage all registered members of GIVE-AID.</p>
    </div>
</div>

<div class="card">
    <div class="toolbar">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input class="input" id="memberSearch" placeholder="Search members by name or email…" onkeyup="filterMembers()">
        </div>
        <div class="filter-row">
            <button type="button" class="btn btn-outline btn-sm"><i class="fa-solid fa-filter"></i> Filter</button>
            <button type="button" class="btn btn-outline btn-sm"><i class="fa-solid fa-arrow-up-from-bracket"></i> Export</button>
        </div>
    </div>

    <div class="table-wrap">
        <table class="data-table" id="membersTable">
            <thead>
                <tr>
                    <th>Member ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Registered</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var member in Model)
                    {
                        <tr>
                            <td>MB-@member.Id.ToString("D4")</td>
                            <td><strong>@member.FullName</strong></td>
                            <td>@member.Email</td>
                            <td>@member.Phone</td>
                            <td>@member.JoinedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (member.Status == "Active")
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-neutral">@member.Status</span>
                                }
                            </td>
                            <td class="row-actions">
                                <a asp-action="Details" asp-route-id="@member.Id" class="icon-btn" title="View details">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                                <a href="#" class="icon-btn danger" title="Delete"
                                   data-modal-target="#deleteMemberModal"
                                   onclick="document.getElementById('confirmDeleteMemberBtn').href='@Url.Action("Delete", new { id = member.Id })'">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">No members found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        <span class="meta">Showing @(Model?.Count() ?? 0) member@(Model != null && Model.Count() == 1 ? "" : "s")</span>
    </div>
</div>

<div class="modal-backdrop" id="deleteMemberModal">
    <div class="modal">
        <div class="modal-icon danger"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <h3>Remove this member?</h3>
        <p class="text-muted">Their donation and programme history will be retained for records.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-outline" data-modal-close>Cancel</button>
            <a id="confirmDeleteMemberBtn" href="#" class="btn btn-danger" data-modal-close>Confirm Delete</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterMembers() {
            const q = document.getElementById('memberSearch').value.toLowerCase();
            document.querySelectorAll('#membersTable tbody tr').forEach(function (row) {
                if (row.cells.length < 2) return;
                const name = row.cells[1].innerText.toLowerCase();
                const email = row.cells[2].innerText.toLowerCase();
                row.style.display = (name.includes(q) || email.includes(q)) ? '' : 'none';
            });
        }
    </script>
}
