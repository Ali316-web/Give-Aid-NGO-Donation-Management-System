@model Give_Aid.Models.AssociatedNGOs

@{
    ViewData["Title"] = "Edit NGO";
    Layout = "_adminlayout";
}

<div class="page-head">
    <div><h1>Edit NGO</h1></div>
</div>

<div class="card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="field"><label>NGO Name<span class="req">*</span></label><input class="input" asp-for="NGOName" /></div>
            <div class="field"><label>Email</label><input class="input" asp-for="Email" /></div>
        </div>
        <div class="form-grid">
            <div class="field"><label>Phone</label><input class="input" asp-for="Phone" /></div>
            <div class="field"><label>Website</label><input class="input" asp-for="Website" /></div>
        </div>

        <div class="field"><label>Location<span class="req">*</span></label><input class="input" asp-for="Location" /></div>
        <div class="field"><label>Address</label><input class="input" asp-for="Address" /></div>
        <div class="field"><label>Focus Area<span class="req">*</span></label><input class="input" asp-for="FocusArea" /></div>
        <div class="field"><label>Description</label><textarea class="input" asp-for="Description" rows="3"></textarea></div>
        <div class="field"><label>Logo URL</label><input class="input" asp-for="LogoUrl" /></div>

        <div class="field">
            <label>Status</label>
            <select class="input" asp-for="Status">
                <option>Active</option>
                <option>Pending</option>
                <option>Inactive</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
        <a asp-action="AdminIndex" class="btn btn-outline btn-sm">Cancel</a>
    </form>
</div>
