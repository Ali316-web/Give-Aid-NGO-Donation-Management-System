@model Give_Aid.Models.AssociatedNGOs

@{
    ViewData["Title"] = "Remove NGO";
    Layout = "_adminlayout";
}

<div class="page-head">
    <div>
        <h1>Remove this NGO?</h1>
        <p class="text-muted" style="margin:0;">They will no longer appear on the public Associated NGOs page.</p>
    </div>
</div>

<div class="card" style="border-color:var(--danger,#dc2626);">
    <dl class="row">
        <dt class="col-sm-3">NGO</dt>
        <dd class="col-sm-9">@Model.NGOName</dd>

        <dt class="col-sm-3">Location</dt>
        <dd class="col-sm-9">@Model.Location</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="AdminIndex" class="btn btn-outline">Cancel</a>
    </form>
</div>
