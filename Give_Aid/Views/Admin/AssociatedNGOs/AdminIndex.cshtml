@model IEnumerable<Give_Aid.Models.AssociatedNGOs>

@{
    ViewData["Title"] = "Associated NGOs";
    Layout = "_adminlayout";
}

<div class="breadcrumb" style="margin-bottom:14px;">
    <a asp-controller="Home" asp-action="Admin">Admin</a><span class="sep">/</span><span class="current">NGOs</span>
</div>

<div class="page-head">
    <div>
        <h1>NGO Management</h1>
        <p class="text-muted" style="margin:0;max-width:56ch;">Add and manage details of NGOs associated with GIVE-AID.</p>
    </div>
    <div class="flex gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Add NGO</a>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>NGO</th>
                    <th>Location</th>
                    <th>Focus Area</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="flex items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(item.LogoUrl))
                                {
                                    <img src="@item.LogoUrl" style="width:32px;height:32px;border-radius:6px;object-fit:cover;" />
                                }
                                @item.NGOName
                            </div>
                        </td>
                        <td>@item.Location</td>
                        <td>@item.FocusArea</td>
                        <td>
                            @{
                                var badgeClass = item.Status switch
                                {
                                    "Active" => "badge-success",
                                    "Pending" => "badge-warning",
                                    _ => "badge-neutral"
                                };
                            }
                            <span class="badge @badgeClass">@item.Status</span>
                        </td>
                        <td class="row-actions">
                            <a asp-action="AdminDetails" asp-route-id="@item.Id" class="icon-btn" title="View"><i class="fa-regular fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-muted text-center">No NGOs yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
