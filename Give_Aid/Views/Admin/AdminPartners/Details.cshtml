@model Give_Aid.Models.Partners

@{
    ViewData["Title"] = "Partner Details";
    Layout = "_adminlayout";
}

<div class="page-head">
    <div><h1>@Model.OrganizationName</h1></div>
</div>

<div class="card">
    <dl class="row">
        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.OrganizationType</dd>

        <dt class="col-sm-3">Website</dt>
        <dd class="col-sm-9">@(Model.Website ?? "—")</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(Model.Description ?? "—")</dd>

        <dt class="col-sm-3">Contact Email</dt>
        <dd class="col-sm-9">@(Model.ContactEmail ?? "—")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Edit</a>
    <a asp-action="Index" class="btn btn-outline btn-sm">Back to Partners</a>
</div>
