@model IEnumerable<Give_Aid.Models.Partners>

@{
    ViewData["Title"] = "Partners";
    Layout = "_adminlayout";
}

<div class="breadcrumb" style="margin-bottom:14px;">
    <a asp-controller="Home" asp-action="Admin">Admin</a><span class="sep">/</span><span class="current">Partners</span>
</div>

<div class="page-head">
    <div>
        <h1>Partner Management</h1>
        <p class="text-muted" style="margin:0;max-width:56ch;">Manage corporate and institutional partners shown on the public site.</p>
    </div>
    <div class="flex gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Add Partner</a>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Partner</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="flex items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(item.LogoUrl))
                                {
                                    <img src="@item.LogoUrl" style="width:32px;height:32px;border-radius:6px;object-fit:cover;" />
                                }
                                @item.OrganizationName
                            </div>
                        </td>
                        <td>@item.OrganizationType</td>
                        <td>
                            @if (item.Status == "Active")
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-neutral">Inactive</span>
                            }
                        </td>
                        <td class="row-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-muted text-center">No partners yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
