@model IEnumerable<Give_Aid.Models.Donation>

@{
    ViewData["Title"] = "Donations";
    Layout = "_adminlayout";
}

<div class="breadcrumb" style="margin-bottom:14px;">
    <a asp-controller="Home" asp-action="Admin">Admin</a><span class="sep">/</span><span class="current">Donations</span>
</div>

<div class="page-head">
    <div>
        <h1>Donation Management</h1>
        <p class="text-muted" style="margin:0;max-width:56ch;">View, filter and manage all donations received across GIVE-AID.</p>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Donation ID</th>
                    <th>Donor</th>
                    <th>Amount</th>
                    <th>Cause</th>
                    <th>Payment Method</th>
                    <th>Transaction ID</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>DN-@item.Id.ToString("D5")</td>
                        <td>
                            @item.DonorName
                            <br />
                            <span class="text-muted" style="font-size:12px;">@item.DonorEmail</span>
                        </td>
                        <td>Rs @item.Amount.ToString("N0")</td>
                        <td>@item.DonationCause?.Cause</td>
                        <td>@item.PaymentMethod •• @item.CardLast4</td>
                        <td>@item.TransactionId</td>
                        <td>@item.DonationDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @{
                                var badgeClass = item.PaymentStatus switch
                                {
                                    "Completed" => "badge-success",
                                    "Pending" => "badge-warning",
                                    _ => "badge-danger"
                                };
                            }
                            <span class="badge @badgeClass">@item.PaymentStatus</span>
                        </td>
                        <td class="row-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="icon-btn" title="View"><i class="fa-regular fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-muted text-center">No donations yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
