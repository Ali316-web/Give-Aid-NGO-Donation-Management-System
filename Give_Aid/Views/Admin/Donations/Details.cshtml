@model Give_Aid.Models.Donation

@{
    ViewData["Title"] = "Donation Details";
    Layout = "_adminlayout";
}

<div class="page-head">
    <div>
        <h1>Donation DN-@Model.Id.ToString("D5")</h1>
    </div>
</div>

<div class="card">
    <dl class="row">
        <dt class="col-sm-3">Donor</dt>
        <dd class="col-sm-9">@Model.DonorName (@Model.DonorEmail)</dd>

        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">Rs @Model.Amount.ToString("N0")</dd>

        <dt class="col-sm-3">Cause</dt>
        <dd class="col-sm-9">@Model.DonationCause?.Cause</dd>

        <dt class="col-sm-3">Payment Method</dt>
        <dd class="col-sm-9">@Model.PaymentMethod •• @Model.CardLast4</dd>

        <dt class="col-sm-3">Card Holder</dt>
        <dd class="col-sm-9">@Model.CardHolderName</dd>

        <dt class="col-sm-3">Transaction ID</dt>
        <dd class="col-sm-9">@Model.TransactionId</dd>

        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.DonationDate.ToString("MMM dd, yyyy · h:mm tt")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.PaymentStatus</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Edit</a>
    <a asp-action="Index" class="btn btn-outline btn-sm">Back to Donations</a>
</div>
