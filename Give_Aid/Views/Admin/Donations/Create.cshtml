@model Give_Aid.Models.Donation

@{
    ViewData["Title"] = "Log a Donation";
    Layout = "_adminlayout";
    var causes = ViewBag.Causes as List<Give_Aid.Models.DonationCause> ?? new();
}

<div class="page-head">
    <div>
        <h1>Log a Donation</h1>
        <p class="text-muted" style="margin:0;">Use this to record an offline donation (cash, bank transfer, etc.) that didn't go through the public Donate page.</p>
    </div>
</div>

<div class="card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="field"><label>Donor Name</label><input class="input" asp-for="DonorName" /></div>
        <div class="field"><label>Donor Email</label><input class="input" asp-for="DonorEmail" /></div>
        <div class="field"><label>Amount</label><input class="input" asp-for="Amount" type="number" /></div>

        <div class="field">
            <label>Cause</label>
            <select class="input" asp-for="CauseId">
                <option value="">Select a cause</option>
                @foreach (var cause in causes)
                {
                    <option value="@cause.Id">@cause.Cause</option>
                }
            </select>
        </div>

        <div class="field"><label>Card Holder Name</label><input class="input" asp-for="CardHolderName" placeholder="N/A for bank transfer/cash" /></div>
        <div class="field"><label>Last 4 Digits</label><input class="input" asp-for="CardLast4" maxlength="4" placeholder="0000 if not applicable" /></div>

        <div class="field">
            <label>Payment Method</label>
            <select class="input" asp-for="PaymentMethod">
                <option>Visa</option>
                <option>Mastercard</option>
                <option>UnionPay</option>
                <option>Bank Transfer</option>
                <option>Cash</option>
            </select>
        </div>

        <div class="field"><label>Transaction ID</label><input class="input" asp-for="TransactionId" placeholder="e.g. manual reference number" /></div>

        <div class="field">
            <label>Status</label>
            <select class="input" asp-for="PaymentStatus">
                <option>Completed</option>
                <option>Pending</option>
                <option>Failed</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary btn-sm">Save Donation</button>
        <a asp-action="Index" class="btn btn-outline btn-sm">Cancel</a>
    </form>
</div>
