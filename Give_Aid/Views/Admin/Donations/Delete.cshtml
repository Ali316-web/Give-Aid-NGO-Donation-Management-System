@model Give_Aid.Models.Donation

@{
    ViewData["Title"] = "Delete Donation";
    Layout = "_adminlayout";
}

<div class="page-head">
    <div>
        <h1>Delete this donation record?</h1>
        <p class="text-muted" style="margin:0;">This action cannot be undone. The donation record will be permanently removed.</p>
    </div>
</div>

<div class="card" style="border-color:var(--danger,#dc2626);">
    <dl class="row">
        <dt class="col-sm-3">Donor</dt>
        <dd class="col-sm-9">@Model.DonorName (@Model.DonorEmail)</dd>

        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">Rs @Model.Amount.ToString("N0")</dd>

        <dt class="col-sm-3">Cause</dt>
        <dd class="col-sm-9">@Model.DonationCause?.Cause</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-outline">Cancel</a>
    </form>
</div>
