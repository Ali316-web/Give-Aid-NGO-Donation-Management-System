@model Give_Aid.Models.AdminUserViewModel

@{
    ViewData["Title"] = "Delete User";
    Layout = "_adminlayout";
}

<div class="page-head">
    <div>
        <h1>Delete User</h1>
        <p class="text-muted" style="margin:0;">Are you sure you want to delete this account? This cannot be undone.</p>
    </div>
</div>

<div class="card" style="border-color:var(--danger,#dc2626);">
    <dl class="row">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@(Model.IsAdmin ? "Admin" : "User")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash"></i> Delete Account
        </button>
        <a asp-action="Index" class="btn btn-outline">Cancel</a>
    </form>
</div>
